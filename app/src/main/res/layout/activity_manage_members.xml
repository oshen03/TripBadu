<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivBackMembers"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/on_surface"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Member Hub"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"/>
    </LinearLayout>

    <!-- Fragment Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/surface">

        <Button
            android:id="@+id/btnTabList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Directory"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"/>

        <Button
            android:id="@+id/btnTabReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reports &amp; Charts"
            android:textSize="13sp"
            android:backgroundTint="@color/text_secondary"
            android:textColor="@color/on_primary"/>
    </LinearLayout>

    <!-- Dynamic Fragment Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>